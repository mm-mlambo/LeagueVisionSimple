@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="min-h-screen flex items-center justify-center bg-slate-950 p-4">
    <div class="bg-slate-900 p-8 rounded-xl shadow-lg w-full max-w-md border border-slate-800">
        <h1 class="text-2xl font-bold text-white text-center mb-6">League Vision</h1>
        
        <!-- Login Form -->
        <form method="post">
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-300 mb-1">Email</label>
                <input asp-for="Input.Email" class="w-full px-4 py-2 rounded-lg bg-slate-800 border border-slate-700 text-white focus:outline-none focus:border-emerald-500" />
                <span asp-validation-for="Input.Email" class="text-red-400 text-sm"></span>
            </div>
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-300 mb-1">Password</label>
                <input asp-for="Input.Password" type="password" class="w-full px-4 py-2 rounded-lg bg-slate-800 border border-slate-700 text-white focus:outline-none focus:border-emerald-500" />
                <span asp-validation-for="Input.Password" class="text-red-400 text-sm"></span>
            </div>
            
            <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2 px-4 rounded-lg transition">Log In</button>
        </form>

        <div class="mt-6 text-center">
            <a asp-page="./Register" class="text-emerald-400 hover:underline">Create an account</a>
        </div>

        <hr class="my-6 border-slate-700" />

        <!-- The Guest Button triggers the OnGetGuest method in the .cs file -->
        <a href="/Identity/Account/Login?handler=Guest" class="block text-center w-full bg-slate-700 hover:bg-slate-600 text-white font-bold py-2 px-4 rounded-lg transition">
            Continue as Guest
        </a>
    </div>
</div>