<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-LeagueVisionSimple-174f1d28-f38f-418c-a8f6-ae73f5e13fc3</UserSecretsId>
    <!-- This line hides the minor package warnings -->
    <NoWarn>NU1901;NU1903</NoWarn>
