@page
@model LeagueVisionSimple.Pages.PlayersModel
@{
    ViewData["Title"] = "Players";
}

<h1 class="text-3xl font-bold mb-6 text-emerald-400">Premier League Players</h1>

<!-- The Search Form -->
<form method="get" class="mb-6 flex gap-3">
    <input type="text" name="SearchTerm" value="@Model.SearchTerm" placeholder="Search player name..." 
           class="px-4 py-2 rounded-lg bg-slate-800 border border-slate-700 text-white focus:outline-none focus:border-emerald-500 w-full md:w-64" />
    <button type="submit" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2 px-6 rounded-lg transition">Search</button>
    @if (!string.IsNullOrEmpty(Model.SearchTerm))
    {
        <a href="/Players" class="bg-slate-700 hover:bg-slate-600 text-white font-bold py-2 px-4 rounded-lg transition">Clear</a>
    }
</form>

<div class="overflow-x-auto rounded-lg border border-slate-800">
    <table class="w-full text-sm">
        <thead class="bg-slate-900 text-gray-400">
            <tr>
                <th class="p-3 text-left">Name</th>
                <th class="p-3 text-left">Team</th>
                <th class="p-3 text-left">Position</th>
                <th class="p-3 text-right">Price</th>
                <th class="p-3 text-right text-emerald-400">Expected (xP)</th>
                <th class="p-3 text-right">Total Points</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Players.Count == 0)
            {
                <tr>
                    <td colspan="6" class="p-6 text-center text-gray-400">No players found matching your search.</td>
                </tr>
            }
            else
            {
                @foreach (var player in Model.Players)
                {
                    <!-- Clickable Row -->
                    <tr class="border-t border-slate-800 hover:bg-slate-900 transition cursor-pointer" 
                        onclick="window.location.href='/PlayerDetail?id=@player.Id'">
                        <td class="p-3">
                            <a href="/PlayerDetail?id=@player.Id" class="text-emerald-400 hover:underline">@player.Name</a>
                        </td>
                        <td class="p-3">@player.Team</td>
                        <td class="p-3">@player.Position</td>
                        <td class="p-3 text-right">£@player.Cost</td>
                        <!-- Show Expected Points -->
                        <td class="p-3 text-right font-bold text-emerald-400">@player.Xp</td>
                        <td class="p-3 text-right text-gray-400">@player.TotalPoints</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>