@page
@{
    ViewData["Title"] = "About";
}

<h1 class="text-3xl font-bold mb-6 text-emerald-400">About League Vision</h1>
<div class="bg-slate-900 p-6 rounded-lg border border-slate-800 text-gray-300 leading-relaxed">
    <p class="mb-4">League Vision is a simple web application built for a first-year Application Development project.</p>
    <p class="mb-4">The app uses C# and Razor Pages to fetch real-time data from the official Fantasy Premier League API. It allows users to view player statistics, check historical predicted vs actual points, and analyze their FPL team.</p>
    <p>All code is written in C# and HTML with Tailwind CSS for a clean, modern dark theme.</p>
</div>