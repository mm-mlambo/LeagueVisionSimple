@page
@model LeagueVisionSimple.Pages.AnalyzeModel
@{
    ViewData["Title"] = "Analyze Team";
}

<h1 class="text-3xl font-bold mb-6 text-emerald-400">Analyze Your FPL Team</h1>

<details class="mb-6 bg-slate-900 rounded-lg border border-slate-800 overflow-hidden">
    <summary class="p-4 text-emerald-400 font-bold cursor-pointer hover:bg-slate-800 transition outline-none select-none">
        ❓ How do I find my Team ID?
    </summary>
    <div class="p-4 border-t border-slate-800 text-sm text-gray-300 leading-relaxed">
        <p class="mb-2">1. Log in to the official <strong>Fantasy Premier League</strong> website.</p>
        <p class="mb-2">2. Click on the <strong>Points</strong> tab in the top menu.</p>
        <p class="mb-2">3. Look at the URL in your browser's address bar:</p>
        <div class="bg-slate-950 p-3 rounded border border-slate-800 text-emerald-400 font-mono text-xs mb-2 overflow-x-auto">
            https://fantasy.premierleague.com/entry/<strong class="text-white">3696025</strong>/event/10
        </div>
        <p>The number in the middle is your Team ID.</p>
    </div>
</details>

<form method="post" class="bg-slate-900 p-6 rounded-lg border border-slate-800 mb-6">
    <label class="block text-sm font-medium text-gray-300 mb-2">Enter your FPL Team ID</label>
    <input asp-for="TeamId" type="number" class="w-full md:w-1/2 px-4 py-2 rounded-lg bg-slate-800 border border-slate-700 text-white mb-4" placeholder="e.g. 3696025" />
    <button type="submit" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2 px-6 rounded-lg transition">Analyze & Get Transfers</button>
</form>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="p-4 bg-slate-800 rounded-lg text-emerald-400 border border-emerald-800 mb-6">
        @Model.Message
    </div>

    @if (Model.Suggestions.Count > 0)
    {
        <h2 class="text-xl font-bold mb-4 text-white">Recommended Transfers</h2>
        <div class="grid gap-3">
            @foreach (var s in Model.Suggestions)
            {
                <div class="bg-slate-900 p-4 rounded-lg border border-slate-800 flex justify-between items-center">
                    
                    <!-- Sell Side -->
                    <div class="w-1/3">
                        <div class="text-xs text-red-400 font-bold mb-1">SELL</div>
                        <div class="font-semibold text-white">@s.SellName</div>
                        <div class="text-xs text-gray-400">Expected: @s.SellXp xP</div>
                    </div>

                    <div class="text-gray-500 text-2xl">➡️</div>

                    <!-- Buy Side -->
                    <div class="w-1/3 text-right">
                        <div class="text-xs text-emerald-400 font-bold mb-1">BUY</div>
                        <div class="font-semibold text-white">@s.BuyName</div>
                        <div class="text-xs text-gray-400">Expected: @s.BuyXp xP | £@s.BuyCost</div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="p-4 bg-slate-900 rounded-lg text-gray-400 border border-slate-800">
            No immediate upgrades found. Your squad is looking good!
        </div>
    }
}